{
  "name": "dsh-deepseek-web-login",
  "version": "0.3.0",
  "description": "Unofficial DSH plugin: use chat.deepseek.com web models as a DSH LLM provider (browser login capture + PoW solving + SSE streaming + prompting-based tool calls), provider route deepseek-web",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts/build.sh",
    "scripts/build.mjs",
    "scripts/prepare.mjs",
    "scripts/make-dev-copy.mjs",
    "README.md",
    "README.en.md",
    "docs/assets",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cv-superding/dsh-deepseek-web-login.git"
  },
  "homepage": "https://github.com/cv-superding/dsh-deepseek-web-login#readme",
  "bugs": {
    "url": "https://github.com/cv-superding/dsh-deepseek-web-login/issues"
  },
  "license": "Apache-2.0",
  "author": "cv-superding (Ding Li)",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "deepseek",
    "llm",
    "provider"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test-offline.mjs",
    "prepare": "node scripts/prepare.mjs"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "tsdown": "0.22.14",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
