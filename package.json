{
  "name": "dsh-deepseek-web-login",
  "version": "0.1.18",
  "description": "Unofficial DSH plugin: use chat.deepseek.com web models as a DSH LLM provider (browser login capture + PoW solving + SSE streaming + prompting-based tool calls), provider route deepseek-web",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts/build.sh",
    "scripts/prepare.mjs",
    "scripts/make-dev-copy.mjs",
    "README.md",
    "README.en.md",
    "docs/assets",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md",
    "tools"
  ],
  "license": "Apache-2.0",
  "author": "cv-superding (Ding Li)",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis-plugin",
    "deepseek",
    "llm",
    "provider"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:client": "tsdown",
    "prepare": "node scripts/prepare.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  }
}
